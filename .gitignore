# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local data store & caches (never commit backfilled data)
# NB: anchored to repo root so the fantasy_gm/data/ source package is NOT ignored.
/data/
*.sqlite
*.db
*.duckdb
raw_cache/

# Secrets
.env
*.secret

# OS / editor
.DS_Store
.idea/
.vscode/

# OpenSpec stray init test artifact
.openspec-test-*

# Throwaway connectivity probe
probe_nba.py

# Web tools build artifacts (regenerated by scripts/deploy_webtools.py).
# NB: the vendored api/fantasy_gm package and api/store/snapshot.sqlite are
# TRACKED and must ship with every push (git-integration deploys bundle
# them) — ignore only untracked strays and negate the shipped files, or
# `git add` refuses the daily snapshot (silent stale-data failure class).
api/fantasy_gm/*
api/store/*
!api/fantasy_gm/**
!api/store/snapshot.sqlite
.vercel
.env*
